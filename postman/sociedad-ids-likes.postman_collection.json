        {
          "name": "Listar mis likes (incluye visible)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const visibleBlogId = pm.collectionVariables.get(\"visibleBlogId\");",
                  "pm.test(\"incluye el post visible\", function () {",
                  "  pm.expect(body.data).to.be.an(\"array\");",
                  "  pm.expect(body.data.some(function (like) { return like.blogId === visibleBlogId; })).to.eql(true);",
                  "});",
                  "pm.test(\"el Blog embebido está visible\", function () {",
                  "  const like = body.data.find(function (item) { return item.blogId === visibleBlogId; });",
                  "  pm.expect(like.Blog.isVisible).to.eql(true);",
                  "});"
                ]
